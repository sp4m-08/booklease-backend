# Supabase PostgreSQL Connection String (IPv4 Connection Pooler recommended)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require"

# Server Port (Optional, defaults to 8080)
PORT=8080

# Firebase Service Account Path (Optional, defaults to firebase-service-account.json)
FIREBASE_CREDENTIALS_PATH=firebase-service-account.json

# Allowed Email Domains for Auth (Comma-separated, or * to allow all. Defaults to vitstudent.ac.in)
ALLOWED_EMAIL_DOMAINS=vitstudent.ac.in

# CORS Allowed Origins (Comma-separated, e.g. https://myfrontend.com)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# -------------------------------------------------------------
# AWS S3 Storage Configuration (for direct book covers & note PDFs)
# -------------------------------------------------------------
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-booklease-bucket
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Optional: CloudFront CDN or custom domain (e.g., https://cdn.booklease.com)
# AWS_S3_CUSTOM_DOMAIN=https://cdn.booklease.com

# Optional: Custom S3 Endpoint (if using Cloudflare R2, MinIO, or Supabase Storage S3)
# AWS_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
